      <aliases enabled='yes' />
      <column caption='Abs Profit' datatype='real' name='[Calculation_0650096891985920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Profit])' />
      </column>
      <column caption='Total Order' datatype='integer' name='[Calculation_0928822342594560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Order_ID])' />
      </column>
      <column caption='Profit Margin (Overall )' datatype='real' default-format='p0.00%' name='[Calculation_0928822344970241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Profit]) / sum([Sales])' />
      </column>
      <column caption='Average Order Value (AOV)' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0928822346317826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Sales])/COUNTD([Order_ID])' />
      </column>
      <column caption='Total Product' datatype='integer' name='[Calculation_0928822403346436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Product_Name])' />
      </column>
      <column caption='Loss' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_1284789681197057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Profit] &lt; 0 then [Profit] END)' />
      </column>
      <column caption='Profit/Loss' datatype='string' name='[Calculation_1284789704314883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;Profit&quot;&#13;&#10;ELSEIF [Profit] = 0 THEN &quot;Break-even&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='Dummy' datatype='integer' name='[Calculation_1284789810655238]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='min(1)' />
      </column>
      <column caption='Growth MoM' datatype='real' default-format='p0.0%' name='[Calculation_1284789823873031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Profit]) - LOOKUP(SUM([Profit]), -1)) &#13;&#10;/ LOOKUP(SUM([Profit]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
      <column caption='Customer Name' datatype='string' name='[Customer_Name]' role='dimension' type='nominal' />
      <column aggregation='None' datatype='integer' name='[Discount (bin)]' role='dimension' type='quantitative'>
