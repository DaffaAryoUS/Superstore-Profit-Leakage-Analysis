      <table>
        <view>
          <datasources>
            <datasource caption='SuperStoreDataset' name='federated.0bgfio41al7uq412jk5po1iy3dud' />
          </datasources>
          <datasource-dependencies datasource='federated.0bgfio41al7uq412jk5po1iy3dud'>
            <column caption='Average Order Value (AOV)' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0928822346317826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Sales])/COUNTD([Order_ID])' />
            </column>
            <column caption='Profit/Loss' datatype='string' name='[Calculation_1284789704314883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;Profit&quot;&#13;&#10;ELSEIF [Profit] = 0 THEN &quot;Break-even&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
            </column>
